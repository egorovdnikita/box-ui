{
  "name": "@box-ui/icons",
  "version": "0.2.0",
  "description": "Иконки Box UI — набор UI Icons из Foundation – Core, переключаемый по всем шести модам Style из Figma и размеряемый токенами Box UI.",
  "keywords": [
    "icons",
    "solar-icons",
    "react",
    "figma",
    "design-system"
  ],
  "homepage": "https://egorovdnikita.github.io/box-ui/",
  "bugs": {
    "url": "https://github.com/egorovdnikita/box-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egorovdnikita/box-ui.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./catalog.json": "./src/catalog.json",
    "./figma-families.json": "./src/figma-families.json",
    "./families.json": "./src/families.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-families.mjs"
