{
  "name": "@box-ui/tokens",
  "version": "0.1.0",
  "description": "Дизайн-токены, сгенерированные из переменных Figma «Box UI» (примитивы, цветовые моды, светлая и тёмная темы, плотность скруглений, гарнитуры, desktop и mobile).",
  "keywords": [
    "design-tokens",
    "css-variables",
    "figma-variables",
    "design-system"
  ],
  "homepage": "https://egorovdnikita.github.io/box-ui/",
  "bugs": {
    "url": "https://github.com/egorovdnikita/box-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egorovdnikita/box-ui.git",
    "directory": "packages/tokens"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/index.css",
    "./css/primitives.css": "./dist/css/primitives.css",
    "./css/theme.css": "./dist/css/theme.css",
    "./css/adaptive.css": "./dist/css/adaptive.css",
    "./tokens.json": "./dist/tokens.json",
    "./css/controls.css": "./dist/css/controls.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  }
}
