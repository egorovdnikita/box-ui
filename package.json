{
  "name": "box-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Box UI \u2014 \u0434\u0438\u0437\u0430\u0439\u043d-\u0442\u043e\u043a\u0435\u043d\u044b \u0438 \u0438\u043a\u043e\u043d\u043a\u0438, \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0438\u0437 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a Figma Box UI, \u0441\u043e Storybook, \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u0443\u044e \u043c\u043e\u0434\u0443 Figma \u043c\u043e\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0432\u0436\u0438\u0432\u0443\u044e.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build -w @box-ui/tokens && npm run build -w @box-ui/icons && node scripts/build-llms-txt.mjs",
    "build:tokens": "npm run build -w @box-ui/tokens",
    "build:icons": "npm run build -w @box-ui/icons",
    "icons:figma": "node scripts/export-figma-icons.mjs",
    "storybook": "npm run dev -w @box-ui/storybook",
    "build:storybook": "npm run build -w @box-ui/storybook",
    "deploy:storybook": "npm run build:storybook && node scripts/deploy-storybook.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:storybook",
    "build:llms": "node scripts/build-llms-txt.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@web3icons/core": "^4.0.55",
    "cryptocurrency-icons": "^0.18.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "flag-icons": "^7.5.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "simple-icons": "^16.28.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
