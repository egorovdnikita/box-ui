{
  "name": "box-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Box UI \u2014 design tokens and icons generated from the Box UI Figma libraries, with a Storybook that lets you switch every Figma mode live.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build -w @box-ui/tokens && npm run build -w @box-ui/icons",
    "build:tokens": "npm run build -w @box-ui/tokens",
    "build:icons": "npm run build -w @box-ui/icons",
    "icons:figma": "node scripts/export-figma-icons.mjs",
    "storybook": "npm run dev -w @box-ui/storybook",
    "build:storybook": "npm run build -w @box-ui/storybook",
    "deploy:storybook": "npm run build:storybook && node scripts/deploy-storybook.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@web3icons/core": "^4.0.55",
    "cryptocurrency-icons": "^0.18.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "flag-icons": "^7.5.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "simple-icons": "^16.28.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
